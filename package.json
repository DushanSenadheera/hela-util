{
  "name": "hela-util",
  "version": "3.0.0",
  "description": "Ultra-lightweight, type-safe utility for Sri Lankan administrative regions (provinces, districts, DS divisions) and postal codes.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --minify --clean --splitting --treeshake",
    "dev": "tsx example.ts"
  },
  "keywords": [
    "sri lanka",
    "provinces",
    "districts",
    "ds divisions",
    "postal codes",
    "hela-util",
    "npm",
    "util",
    "typescript",
    "ceylon",
    "lk",
    "administrative-regions"
  ],
  "author": "Dushan Senadheera",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}