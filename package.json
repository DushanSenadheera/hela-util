{
  "name": "hela-util",
  "version": "4.1.0",
  "description": "Ultra-lightweight, type-safe utility library for Sri Lankan administrative regions and postal codes with multilingual support.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --minify --clean --splitting --treeshake",
    "dev": "tsx example.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sri lanka",
    "provinces",
    "districts",
    "ds divisions",
    "gn divisions",
    "postal codes",
    "hela-util",
    "typescript",
    "administrative-regions",
    "multilingual"
  ],
  "author": "Dushan Senadheera",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DushanSenadheera/hela-util.git"
  },
  "bugs": {
    "url": "https://github.com/DushanSenadheera/hela-util/issues"
  },
  "homepage": "https://github.com/DushanSenadheera/hela-util#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}