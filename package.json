{
  "name": "hela-util",
  "version": "2.1.0",
  "description": "A utility library for Sri Lankan administrative regions and postal codes",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --minify --clean",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsup index.ts --watch"
  },
  "keywords": [
    "sri lanka",
    "provinces",
    "districts",
    "ds divisions",
    "postal codes",
    "hela-util",
    "npm",
    "util",
    "typescript"
  ],
  "author": "Dushan Senadheera",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0"
  }
}